# Copia este archivo a .env (que no se sube a git) y rellena los valores.
# En CI, los mismos nombres van en GitHub Secrets. Nunca pegues valores reales aquí.

# Mercado por defecto (id de config/markets/<mercado>.json)
MARKET=es

# Cuentas de prueba de Betsson, una por mercado (<MERCADO> en mayúsculas)
BETSSON_ES_USERNAME=
BETSSON_ES_PASSWORD=
# Cuenta sin saldo para el escenario 2 (si nos la dan)
BETSSON_ES_EMPTY_USERNAME=
BETSSON_ES_EMPTY_PASSWORD=

# Opcional: visión con IA (perfil generic-vision)
ANTHROPIC_API_KEY=
