<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Validación de juegos{% endblock %}</title>
<style>
  :root { --pass:#1f8a4c; --fail:#c62828; --inc:#b26a00; --ui:#6a3fb5; --ink:#1d2330; --muted:#5d6675; --line:#e3e6ec; --bg:#f7f8fa; }
  * { box-sizing: border-box; }
  body { margin:0; font:15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; color:var(--ink); background:var(--bg); }
  main { max-width:1100px; margin:0 auto; padding:24px 16px 48px; }
  h1 { font-size:22px; margin:0 0 4px; } h2 { font-size:17px; margin:28px 0 8px; }
  .meta { color:var(--muted); font-size:13px; }
  .badge { display:inline-block; padding:2px 10px; border-radius:999px; color:#fff; font-weight:600; font-size:12px; letter-spacing:.03em; }
  .PASS { background:var(--pass); } .FAIL { background:var(--fail); }
  .INCONCLUSIVE, .inconclusive { background:var(--inc); } .PROVIDER_UI_CHANGED, .provider_ui_changed { background:var(--ui); }
  .integration { background:var(--fail); }
  .summary { display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin:12px 0; }
  .notice { border-left:4px solid var(--ui); background:#fff; padding:10px 14px; margin:12px 0; }
  .notice.error { border-color:var(--fail); }
  table { width:100%; border-collapse:collapse; background:#fff; border:1px solid var(--line); }
  th, td { text-align:left; vertical-align:top; padding:8px 10px; border-bottom:1px solid var(--line); }
  th { font-size:12px; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); background:#fbfbfd; }
  td code { font-size:12px; }
  .ev { display:flex; gap:6px; flex-wrap:wrap; margin-top:6px; }
  .ev img { max-width:180px; max-height:110px; border:1px solid var(--line); border-radius:4px; }
  .wrap { overflow-x:auto; }
  .readings { display:grid; grid-template-columns:repeat(auto-fill, minmax(230px, 1fr)); gap:12px; }
  .card { background:#fff; border:1px solid var(--line); border-radius:8px; padding:10px; }
  .card.doubt { border-color:var(--inc); box-shadow:inset 3px 0 0 var(--inc); }
  .card img { width:100%; max-height:150px; object-fit:contain; background:#111; border-radius:4px; }
  .card .name { font-weight:600; } .card .src { color:var(--muted); font-size:12px; text-transform:uppercase; }
  .card .val { font-size:18px; font-weight:600; margin:4px 0; } .card .ocr { font-family:ui-monospace,monospace; font-size:12px; color:var(--muted); }
  a { color:#1a5fb4; }
  .tiles { display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:12px; margin:12px 0 8px; }
  .tile { display:block; background:#fff; border:1px solid var(--line); border-radius:10px; padding:12px 14px; color:inherit; text-decoration:none; border-top:5px solid var(--line); }
  .tile.PASS { border-top-color:var(--pass); } .tile.FAIL { border-top-color:var(--fail); }
  .tile.INCONCLUSIVE { border-top-color:var(--inc); } .tile.PROVIDER_UI_CHANGED { border-top-color:var(--ui); }
  .tile-head { margin-bottom:6px; font-size:16px; }
  .flag { display:inline-block; margin:6px 6px 0 0; padding:2px 8px; border-radius:4px; font-size:12px; font-weight:600; }
  .flag.info { background:#e7f0ff; color:#1a4fa0; } .flag.ui { background:#efe7fb; color:var(--ui); } .flag.err { background:#fde8e8; color:var(--fail); }
  .strip { display:flex; gap:6px; margin-top:10px; } .strip img { width:23%; height:56px; object-fit:cover; border-radius:4px; background:#111; }
  .matrix td, .matrix th { text-align:center; } .matrix td:first-child, .matrix th:first-child { text-align:left; }
  .notice.info { border-color:#1a5fb4; }
</style>
</head>
<body><main>
{% block body %}{% endblock %}
</main></body>
</html>
