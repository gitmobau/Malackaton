{% extends "_base.html.j2" %}
{% block title %}{{ run.scenario.value }} · {{ run.market }} · {{ run.outcome }}{% endblock %}
{% block body %}
<h1>{{ run.scenario.value }} en el mercado {{ run.market }}</h1>
<div class="meta">
  Run {{ run.run_id }} · juego {{ run.game or "—" }} · perfil {{ run.provider or "sin detectar" }}
  · {{ run.started_at.strftime("%Y-%m-%d %H:%M:%S") }} UTC
  {% if run.finished_at %}({{ "%.1f"|format((run.finished_at - run.started_at).total_seconds()) }} s){% endif %}
</div>

<div class="summary">
  <span class="badge {{ run.outcome }}">{{ run.outcome }}</span>
  {% set passed = run.results|selectattr("status", "equalto", "PASS")|list|length %}
  <span>{{ passed }} de {{ run.results|length }} comprobaciones en PASS</span>
  {% if run.missing_checks %}<span class="meta">· sin resultado: {{ run.missing_checks|map(attribute="value")|join(", ") }}</span>{% endif %}
</div>

{% if run.error %}
<div class="notice error"><strong>La ejecución se cortó:</strong> {{ run.error }}</div>
{% endif %}
{% for w in run.warnings %}
{% if w == LOGIN_ASSISTED_WARNING %}
<div class="notice info"><strong>Login asistido por una persona</strong> (autorizado por los mentores): una persona inició la sesión en Betsson; todo lo demás —abrir el juego, leer la pantalla, girar y verificar— lo hizo el comprobador solo.</div>
{% else %}
<div class="notice"><strong>Aviso:</strong> {{ w }}{% if "PROVIDER_UI_CHANGED" in w %} — el juego del proveedor ha cambiado; hay que revisar su perfil. No es un fallo de integración de Betsson.{% elif "ha cambiado desde la última ejecución" in w %} — no cambia el veredicto; capturas de antes y ahora en «Evidencias generales».{% endif %}</div>
{% endif %}
{% endfor %}

{% if run.readings %}
<h2>Lo que vio el comprobador</h2>
<p class="meta">Cada importe se lee de la pantalla como lo vería un jugador (OCR sobre el canvas o el saldo de la web). La red y el monedero solo confirman.</p>
<div class="readings">
  {% for r in run.readings %}
  <div class="card{% if not r.value %} doubt{% endif %}">
    <div class="src">{{ r.source }}</div>
    <div class="name">{{ r.name }}</div>
    {% if r.evidence %}<a href="{{ r.evidence|posix|urlencode }}"><img src="{{ r.evidence|posix|urlencode }}" alt="{{ r.name }}"></a>{% endif %}
    <div class="val">{{ r.value or "dudoso" }}</div>
    <div class="ocr">OCR: «{{ r.raw_text or "—" }}»</div>
    <div class="meta">
      {% if r.confidence is not none %}confianza {{ "%.0f"|format(r.confidence * 100) }} %{% endif %}
      {% if r.currency_seen is not none %} · moneda {{ "vista" if r.currency_seen else "no vista" }}{% endif %}
    </div>
    {% if r.reason %}<div class="meta">{{ r.reason }}</div>{% endif %}
  </div>
  {% endfor %}
</div>
{% endif %}

<h2>Comprobaciones</h2>
<div class="wrap">
<table>
  <thead><tr><th>Comprobación</th><th>Resultado</th><th>Motivo</th><th>Esperado</th><th>Observado</th></tr></thead>
  <tbody>
  {% for r in run.results %}
    <tr>
      <td><code>{{ r.id.value }}</code></td>
      <td>
        <span class="badge {{ r.status }}">{{ r.status }}</span>
        {% if r.failure_kind %}<br><span class="badge {{ r.failure_kind.value }}">{{ r.failure_kind.value }}</span>{% endif %}
      </td>
      <td>
        {{ r.reason }}
        {% if r.evidence %}
        <div class="ev">
          {% for p in r.evidence %}
            {% if p is image %}<a href="{{ p|posix|urlencode }}"><img src="{{ p|posix|urlencode }}" alt="{{ p.name }}"></a>
            {% else %}<a href="{{ p|posix|urlencode }}">{{ p.name }}</a>{% endif %}
          {% endfor %}
        </div>
        {% endif %}
      </td>
      <td>{{ r.expected or "—" }}</td>
      <td>{{ r.observed or "—" }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>

{% if run.evidence %}
<h2>Evidencias generales</h2>
<div class="ev">
  {% for p in run.evidence %}
    {% if p is image %}<a href="{{ p|posix|urlencode }}"><img src="{{ p|posix|urlencode }}" alt="{{ p.name }}" title="{{ p.name }}"></a>
    {% else %}<a href="{{ p|posix|urlencode }}">{{ p|posix }}</a>{% endif %}
  {% endfor %}
</div>
{% endif %}

<p class="meta">Datos en bruto: <a href="results.json">results.json</a>. Lo dudoso cuenta como FAIL no concluyente; nunca como PASS.</p>
{% endblock %}
